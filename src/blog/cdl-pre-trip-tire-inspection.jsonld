<script type="application/ld+json">{"@context": "https://schema.org", "@type": "Article", "headline": "CDL pre-trip tire inspection: what to check and what examiners look for", "description": "The tire part of a CDL pre-trip, in plain English: tread depth (4/32 steer, 2/32 others), inflation, cuts, duals, valve stems and the rule on recaps for bus front tires.", "datePublished": "2026-12-18", "dateModified": "2026-12-18", "image": "https://tiresforanything.com/og/cdl-pre-trip-tire-inspection.png", "author": {"@type": "Person", "name": "Brad", "jobTitle": "Founder, Tires for Anything", "description": "Former Class 8 truck tire technician, Army Reserve motor sergeant and private pilot.", "url": "https://tiresforanything.com/blog/cdl-pre-trip-tire-inspection#author"}, "publisher": {"@type": "Organization", "name": "Tires for Anything", "url": "https://tiresforanything.com/"}, "mainEntityOfPage": "https://tiresforanything.com/blog/cdl-pre-trip-tire-inspection"}</script>
<script type="application/ld+json">{"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "What's the minimum tread depth for a CDL inspection?", "acceptedAnswer": {"@type": "Answer", "text": "4/32 inch on steer tires, 2/32 inch on all other tires."}}, {"@type": "Question", "name": "Can I use recaps on a bus?", "acceptedAnswer": {"@type": "Answer", "text": "Not on the front wheels. They're allowed in other positions."}}, {"@type": "Question", "name": "Can I thump tires instead of using a gauge?", "acceptedAnswer": {"@type": "Answer", "text": "It finds flats, not low tires. Use a gauge for pressure."}}, {"@type": "Question", "name": "What if my duals are different sizes?", "acceptedAnswer": {"@type": "Answer", "text": "That's a defect. The bigger tire carries more load and can fail."}}]}</script>
