<script type="application/ld+json">{"@context": "https://schema.org", "@type": "Article", "headline": "How to replace office chair casters, and pick the right casters for carts and shelves", "description": "How to swap office chair casters, pick wheels for hardwood or carpet, and choose plate, stem or threaded casters with the right load rating for carts, shelving and tool chests.", "datePublished": "2026-10-25", "dateModified": "2026-10-25", "image": "https://tiresforanything.com/og/how-to-replace-office-chair-casters.png", "author": {"@type": "Person", "name": "Brad", "jobTitle": "Founder, Tires for Anything", "description": "Former Class 8 truck tire technician, Army Reserve motor sergeant and private pilot.", "url": "https://tiresforanything.com/blog/how-to-replace-office-chair-casters#author"}, "publisher": {"@type": "Organization", "name": "Tires for Anything", "url": "https://tiresforanything.com/"}, "mainEntityOfPage": "https://tiresforanything.com/blog/how-to-replace-office-chair-casters"}</script>
<script type="application/ld+json">{"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Are office chair casters universal?", "acceptedAnswer": {"@type": "Answer", "text": "Most are. The majority of office and gaming chairs use a 7/16 x 7/8 inch grip ring stem, also listed as 11 x 22 mm. Some use 10 mm stems, so pull one and measure before you buy."}}, {"@type": "Question", "name": "How do I get a stuck office chair wheel out?", "acceptedAnswer": {"@type": "Answer", "text": "Pull straight out while wiggling the wheel. If it won't come, pry gently between the wheel and the chair base with a flathead screwdriver."}}, {"@type": "Question", "name": "What casters won't scratch hardwood floors?", "acceptedAnswer": {"@type": "Answer", "text": "Soft polyurethane or rubber wheels, often sold as rollerblade-style chair casters. Hard plastic wheels are made for carpet."}}, {"@type": "Question", "name": "How do I figure out what load rating I need?", "acceptedAnswer": {"@type": "Answer", "text": "Add the cart and its heaviest load together, then divide by three. Each caster should be rated for at least that much."}}, {"@type": "Question", "name": "Should all four casters swivel?", "acceptedAnswer": {"@type": "Answer", "text": "Usually not. Two swivel and two rigid is easier to push straight. All four swivel is best for tight spaces where you need to move sideways."}}]}</script>
<script type="application/ld+json">{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://tiresforanything.com/"}, {"@type": "ListItem", "position": 2, "name": "Blog", "item": "https://tiresforanything.com/blog/"}, {"@type": "ListItem", "position": 3, "name": "Casters", "item": "https://tiresforanything.com/blog/how-to-replace-office-chair-casters"}]}</script>