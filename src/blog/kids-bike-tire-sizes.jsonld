<script type="application/ld+json">{"@context": "https://schema.org", "@type": "Article", "headline": "Kids' bike tire sizes, 12 to 24 inch, explained", "description": "Find the right replacement tire or tube for a kid's bike. Sizes by age, the decimal vs. fraction trap that trips everybody up, and valve types.", "datePublished": "2026-11-25", "dateModified": "2026-11-25", "image": "https://tiresforanything.com/og/kids-bike-tire-sizes.png", "author": {"@type": "Person", "name": "Brad", "jobTitle": "Founder, Tires for Anything", "description": "Former Class 8 truck tire technician, Army Reserve motor sergeant and private pilot.", "url": "https://tiresforanything.com/blog/kids-bike-tire-sizes#author"}, "publisher": {"@type": "Organization", "name": "Tires for Anything", "url": "https://tiresforanything.com/"}, "mainEntityOfPage": "https://tiresforanything.com/blog/kids-bike-tire-sizes"}</script>
<script type="application/ld+json">{"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "What size bike tire for a 6-year-old?", "acceptedAnswer": {"@type": "Answer", "text": "Usually a 16 or 20 inch, depending on height."}}, {"@type": "Question", "name": "Will a 20x1.95 tire fit a 20x2.125 wheel?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Both are decimal sizes on the same 406 wheel. Only the width is different."}}, {"@type": "Question", "name": "Will a 20x1-3/8 tire fit a 20x1.95 wheel?", "acceptedAnswer": {"@type": "Answer", "text": "No. They're different wheel sizes."}}, {"@type": "Question", "name": "Can I use a car tire pump?", "acceptedAnswer": {"@type": "Answer", "text": "Yes, if the bike has a Schrader valve, which most kids' bikes do. Watch the pressure, because bike tires fill fast."}}]}</script>
