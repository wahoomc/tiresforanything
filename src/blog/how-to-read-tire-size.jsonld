<script type="application/ld+json">{"@context": "https://schema.org", "@type": "Article", "headline": "How to read a tire size, any tire, in 5 minutes", "description": "Read the numbers on any tire sidewall: cars, trucks, trailers, semis, mowers, ATVs, forklifts, motorcycles and bikes. One page, plain English.", "datePublished": "2026-11-11", "dateModified": "2026-11-11", "image": "https://tiresforanything.com/og/how-to-read-tire-size.png", "author": {"@type": "Person", "name": "Brad", "jobTitle": "Founder, Tires for Anything", "description": "Former Class 8 truck tire technician, Army Reserve motor sergeant and private pilot.", "url": "https://tiresforanything.com/blog/how-to-read-tire-size#author"}, "publisher": {"@type": "Organization", "name": "Tires for Anything", "url": "https://tiresforanything.com/"}, "mainEntityOfPage": "https://tiresforanything.com/blog/how-to-read-tire-size"}</script>
<script type="application/ld+json">{"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Can I put a different size tire on my wheel?", "acceptedAnswer": {"@type": "Answer", "text": "Only if the wheel size matches exactly and the new size is approved for your vehicle. Your tire shop can tell you what fits."}}, {"@type": "Question", "name": "What does the dash in a tire size mean?", "acceptedAnswer": {"@type": "Answer", "text": "It usually means bias-ply construction. An R means radial."}}, {"@type": "Question", "name": "Is 700c the same as 29-inch?", "acceptedAnswer": {"@type": "Answer", "text": "On the wheel, yes. Both use the 622 mm bead seat. The tires are different widths and built for different bikes, though."}}, {"@type": "Question", "name": "Where is the size on a forklift tire?", "acceptedAnswer": {"@type": "Answer", "text": "On the sidewall, or stamped on the steel band of a press-on tire."}}, {"@type": "Question", "name": "What do the load index and speed rating mean?", "acceptedAnswer": {"@type": "Answer", "text": "The load index is a code for how much weight each tire carries (102 means 1,874 pounds). The speed rating letter is the top sustained speed, like H for 130 mph."}}]}</script>
<script type="application/ld+json">{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://tiresforanything.com/"}, {"@type": "ListItem", "position": 2, "name": "Blog", "item": "https://tiresforanything.com/blog/"}, {"@type": "ListItem", "position": 3, "name": "How to read a tire size", "item": "https://tiresforanything.com/blog/how-to-read-tire-size"}]}</script>