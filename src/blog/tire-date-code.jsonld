<script type="application/ld+json">{"@context": "https://schema.org", "@type": "Article", "headline": "How old is my tire? Reading the DOT date code", "description": "Find the four-digit date code on any tire, read it in seconds, and learn how old is too old for cars, trailers, RVs and motorcycles.", "datePublished": "2026-11-11", "dateModified": "2026-11-11", "image": "https://tiresforanything.com/og/tire-date-code.png", "author": {"@type": "Person", "name": "Brad", "jobTitle": "Founder, Tires for Anything", "description": "Former Class 8 truck tire technician, Army Reserve motor sergeant and private pilot.", "url": "https://tiresforanything.com/blog/tire-date-code#author"}, "publisher": {"@type": "Organization", "name": "Tires for Anything", "url": "https://tiresforanything.com/"}, "mainEntityOfPage": "https://tiresforanything.com/blog/tire-date-code"}</script>
<script type="application/ld+json">{"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Where is the date on a tire?", "acceptedAnswer": {"@type": "Answer", "text": "In the last four digits of the DOT code on the sidewall. It may be on the inside-facing side only."}}, {"@type": "Question", "name": "What does 3220 mean on a tire?", "acceptedAnswer": {"@type": "Answer", "text": "It was made in week 32 of 2020, which is early August."}}, {"@type": "Question", "name": "Can a tire with good tread be too old?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Rubber breaks down with age even with full tread."}}, {"@type": "Question", "name": "How old is too old for a tire?", "acceptedAnswer": {"@type": "Answer", "text": "Many vehicle makers say replace at 6 years from manufacture, many tire makers say never past 10, and trailer tires often need replacing at 3 to 5 years."}}, {"@type": "Question", "name": "Are new tires from the store ever old?", "acceptedAnswer": {"@type": "Answer", "text": "Sometimes they've been in storage a while. Ask to see the date before you buy."}}]}</script>
<script type="application/ld+json">{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://tiresforanything.com/"}, {"@type": "ListItem", "position": 2, "name": "Blog", "item": "https://tiresforanything.com/blog/"}, {"@type": "ListItem", "position": 3, "name": "Tire date code", "item": "https://tiresforanything.com/blog/tire-date-code"}]}</script>